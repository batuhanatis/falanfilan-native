{
  "expo": {
    "name": "pellix",
    "slug": "falanfilan-native",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pellix",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.batuhanatis.pellix",
      "appleTeamId": "DJMW4M7K54",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.batuhanatis.pellix"]
      },
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": ["applinks:open.pellix.app"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı, kapak fotoğrafı ve sohbetlerde paylaşmak için fotoğraflarına erişim izni istiyoruz.",
        "NSCameraUsageDescription": "Bir fotoğraf çekip o filmi/diziyi bulabilmen için kameranı kullanmamıza izin ver.",
        "NSPhotoLibraryAddUsageDescription": "Oluşturduğun paylaşım kartlarını galerine kaydedebilmemiz için izin gerekiyor.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.batuhanatis.pellix",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "open.pellix.app", "pathPrefix": "/u" },
            { "scheme": "https", "host": "open.pellix.app", "pathPrefix": "/blend" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "./plugins/withAndroidInstagramQueries",
      "./plugins/withAndroidGradleMemory",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı, kapak fotoğrafı ve sohbetlerde paylaşmak için fotoğraflarına erişim izni istiyoruz.",
          "cameraPermission": "Bir fotoğraf çekip o filmi/diziyi bulabilmen için kameranı kullanmamıza izin ver."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Oluşturduğun paylaşım kartlarını galerine kaydedebilmemiz için izin gerekiyor.",
          "savePhotosPermission": "Oluşturduğun paylaşım kartlarını galerine kaydedebilmemiz için izin gerekiyor.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c9a44c"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#14121a",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#14121a"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sqlite",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/widget/BigShoulders_800ExtraBold.ttf",
            "./assets/fonts/widget/BigShoulders_700Bold.ttf",
            "./assets/fonts/widget/DMMono_400Regular.ttf",
            "./assets/fonts/widget/DMMono_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Seans",
              "label": "Bu akşamın seansı",
              "description": "Günün seçkisi ana ekranında; Sıradaki ile panoyu çevir.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "480dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/seans.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "Blend",
              "label": "Blend",
              "description": "Arkadaşınla beğeni uyumunuz ve birlikte izleyebilecekleriniz.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/blend.png",
              "updatePeriodMillis": 21600000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "409c97e3-29fb-41d4-a231-5cb5f7f8b833"
      }
    },
    "owner": "batuhanatis",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/409c97e3-29fb-41d4-a231-5cb5f7f8b833"
    }
  }
}
